      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(cloudnotes_http_request_duration_seconds_bucket[1m])) by (le, endpoint))",
